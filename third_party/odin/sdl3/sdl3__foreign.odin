// myod: generated by third_party/scripts/sync_bindings.py.
// Bindings come from Odin's vendor package; only the foreign imports were rewritten to point at third_party/prebuilt/.

package sdl3

// System libraries needed to link SDL3 statically, taken from the Libs field of sdl3.pc in the SDL build output.
when ODIN_OS == .Darwin && ODIN_ARCH == .arm64 {
	@(export) foreign import lib {
		"../../prebuilt/macos-arm64/libSDL3.a",
		"system:CoreMedia.framework",
		"system:CoreVideo.framework",
		"system:Cocoa.framework",
		"system:UniformTypeIdentifiers.framework",
		"system:IOKit.framework",
		"system:Carbon.framework",
		"system:Foundation.framework",
		"system:Metal.framework",
		"system:QuartzCore.framework",
		"system:pthread",
		"system:m",
	}
} else when ODIN_OS == .Linux && ODIN_ARCH == .amd64 {
	@(export) foreign import lib {
		"../../prebuilt/linux-x86_64/libSDL3.a",
		"system:pthread",
		"system:m",
		"system:dl",
	}
} else when ODIN_OS == .Linux && ODIN_ARCH == .arm64 {
	@(export) foreign import lib {
		"../../prebuilt/linux-arm64/libSDL3.a",
		"system:pthread",
		"system:m",
		"system:dl",
	}
} else {
	#panic("myod does not support this platform yet: only macOS arm64, Linux x86_64 and Linux arm64")
}
