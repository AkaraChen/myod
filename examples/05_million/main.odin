// 05_million: a virtual list over one million variable-height rows (ROADMAP.md, M5).
//
// The data is generated by a background task and handed to the store, which takes ownership of the
// allocation; sorting and filtering are tasks too, each result carrying a generation token so a slow
// one cannot land on newer state. Only the rows in view are declared, so scrolling costs the same at
// row 3 and at row 900,000.
//
//	sort key: the row's id, so measured heights follow the data when the list is reordered
//	row height: the number of words in the row's sentence makes it wrap to 1–3 lines
package million

import "core:fmt"
import "core:sort"

import ui "myod:ui"

ROWS :: 1_000_000

Row :: struct {
	id:    u32,
	group: u32,
	words: u32,
}

Sort :: enum {
	Id,
	Group,
	Words,
}

Filter :: enum {
	All,
	Group_0,
	Group_1,
	Group_2,
	Group_3,
}

SENTENCES := [7]string {
	"",
	"Short.",
	"A row of two words.",
	"Three words make this row a little taller than its neighbour.",
	"Four words are enough to wrap onto a second line at most window widths.",
	"Five words keep going for a while longer, still fitting on two lines here.",
	"Six words is the longest row: at a narrow width its text wraps onto a third line.",
}

// ---- Messages ----

Load :: distinct u64 // generation
Loaded :: struct {
	gen:  u64,
	rows: []Row, // allocated by the task; the store takes ownership
}

Build :: struct {
	gen:    u64,
	rows:   []Row,
	mode:   Sort,
	filter: Filter,
}

Built :: struct {
	gen:    u64,
	order:  []int, // allocated by the task; the store takes ownership
	filter: Filter,
	mode:   Sort,
}

Set_Sort :: distinct Sort
Set_Filter :: distinct Filter
Jump :: distinct int

Msg :: union {
	Load,
	Loaded,
	Build,
	Built,
	Set_Sort,
	Set_Filter,
	Jump,
}

// ---- State ----

State :: struct {
	rows:     []Row,
	order:    []int,
	version:  u64, // bumped when `order` changes; the list drops cached heights
	mode:     Sort,
	filter:   Filter,
	gen:      u64,
	loading:  bool,
	building: bool,
}

update :: proc(s: ^State, msg: Msg, fx: ^ui.Effects(Msg)) {
	switch m in msg {
	case Load:
		if s.loading {
			return
		}
		s.loading = true
		s.gen += 1
		ui.start_task(fx, load_task, Load_Arg{gen = s.gen, count = ROWS})

	case Loaded:
		if m.gen != s.gen {
			delete(m.rows) // a result from a superseded load
			return
		}
		s.loading = false
		if s.rows != nil {
			delete(s.rows)
		}
		s.rows = m.rows
		s.version += 1
		start_build(s, fx)

	case Build:
		// The task reads the rows; they are immutable until the next load.
		ui.start_task(fx, build_task, m)

	case Built:
		if m.gen != s.gen {
			delete(m.order)
			return
		}
		s.building = false
		if s.order != nil {
			delete(s.order)
		}
		s.order = m.order
		s.version += 1

	case Set_Sort:
		if s.building || Sort(m) == s.mode {
			return
		}
		s.mode = Sort(m)
		start_build(s, fx)

	case Set_Filter:
		if s.building || Filter(m) == s.filter {
			return
		}
		s.filter = Filter(m)
		start_build(s, fx)

	case Jump:
		ui.scroll_to_index(fx, "rows", int(m))
	}
}

start_build :: proc(s: ^State, fx: ^ui.Effects(Msg)) {
	if s.rows == nil {
		return
	}
	s.gen += 1
	s.building = true
	ui.start_task(fx, build_task, Build{gen = s.gen, rows = s.rows, mode = s.mode, filter = s.filter})
}

// ---- Tasks ----

Load_Arg :: struct {
	gen:   u64,
	count: int,
}

load_task :: proc(t: ^ui.Task_Context(Msg), arg: Load_Arg) -> Msg {
	rows := make([]Row, arg.count)
	for i in 0 ..< arg.count {
		rows[i] = Row {
			id    = u32(i + 1),
			group = u32(i % 4),
			words = u32(1 + (i * 7) % 6),
		}
	}
	return Loaded{gen = arg.gen, rows = rows}
}

// The task's view of the sort: a `core:sort` interface over the order slice, comparing rows.
@(private)
Build_Ctx :: struct {
	order:  ^[]int,
	rows:   []Row,
	mode:   Sort,
	filter: Filter,
}

build_task :: proc(t: ^ui.Task_Context(Msg), arg: Build) -> Msg {
	n := 0
	for row in arg.rows {
		if passes(row, arg.filter) {
			n += 1
		}
	}
	order := make([]int, n)
	k := 0
	for row, i in arg.rows {
		if passes(row, arg.filter) {
			order[k] = i
			k += 1
		}
	}
	ctx := Build_Ctx{order = &order, rows = arg.rows, mode = arg.mode}
	sort.sort(sort.Interface {
		len  = proc(it: sort.Interface) -> int {return len((^Build_Ctx)(it.collection).order^)},
		less = proc(it: sort.Interface, i, j: int) -> bool {
			c := (^Build_Ctx)(it.collection)
			a := c.rows[c.order^[i]]
			b := c.rows[c.order^[j]]
			switch c.mode {
			case .Id:
				return a.id < b.id
			case .Group:
				if a.group != b.group {
					return a.group < b.group
				}
				return a.id < b.id
			case .Words:
				if a.words != b.words {
					return a.words > b.words
				}
				return a.id < b.id
			}
			return false
		},
		swap = proc(it: sort.Interface, i, j: int) {
			o := (^Build_Ctx)(it.collection).order^
			o[i], o[j] = o[j], o[i]
		},
		collection = &ctx,
	})
	return Built{gen = arg.gen, order = order, filter = arg.filter, mode = arg.mode}
}

passes :: proc(r: Row, f: Filter) -> bool {
	switch f {
	case .All:
		return true
	case .Group_0:
		return r.group == 0
	case .Group_1:
		return r.group == 1
	case .Group_2:
		return r.group == 2
	case .Group_3:
		return r.group == 3
	}
	return true
}

// ---- view ----

view :: proc(s: State, d: ui.Dispatch(Msg)) {
	if s.rows == nil {
		if !s.loading {
			ui.dispatch(d, Load(0))
		}
		if ui.column({padding = 24, gap = 8}) {
			ui.text("一百万行", .Page_Title)
			ui.text("正在生成 1,000,000 行数据…", .Body, color = .Muted)
		}
		return
	}

	// A local copy, so the list's key callback can read the state during this view.
	state := s
	if ui.column({padding = 24, gap = 12, height = ui.grow()}) {
		if ui.row({gap = 12, align_y = .Center}) {
			ui.text("一百万行", .Page_Title)
			ui.spacer()
			if s.building {
				ui.text("排序中…", .Metadata, color = .Muted)
			}
		}
		controls(s, d)
		l := rows_list(&state, d)
		footer(s, l)
	}
}

// Thousands separators, so a million reads as 1,000,000 in the status line.
@(private)
commas :: proc(n: int) -> string {
	if n < 1000 {
		return fmt.tprintf("%d", n)
	}
	if n < 1_000_000 {
		return fmt.tprintf("%d,%03d", n / 1000, n % 1000)
	}
	return fmt.tprintf("%d,%03d,%03d", n / 1_000_000, (n / 1000) % 1000, n % 1000)
}

footer :: proc(s: State, l: ui.Virtual_List) {
	if ui.row({gap = 8, align_y = .Center}) {
		ui.text(fmt.tprintf("%s 行", commas(len(s.order))), .Metadata, color = .Faint)
		ui.spacer()
		if l.open && len(s.order) > 0 {
			ui.text(
				fmt.tprintf("显示第 %s–%s 行", commas(l.visible_first + 1), commas(l.visible_last)),
				.Metadata,
				color = .Faint,
			)
		}
	}
}

controls :: proc(s: State, d: ui.Dispatch(Msg)) {
	if ui.row({gap = 8, align_y = .Center, wrap = true}) {
		for label, mode in ([Sort]string{.Id = "按编号", .Group = "按组", .Words = "按长度"}) {
			variant := ui.Button_Variant.Ghost if s.mode == mode else ui.Button_Variant.Outline
			if ui.button(label, variant = variant, size = .Small).clicked {
				ui.dispatch(d, Set_Sort(mode))
			}
		}
		ui.divider()
		for label, filter in ([Filter]string{.All = "全部", .Group_0 = "组 0", .Group_1 = "组 1", .Group_2 = "组 2", .Group_3 = "组 3"}) {
			variant := ui.Button_Variant.Ghost if s.filter == filter else ui.Button_Variant.Outline
			if ui.button(label, variant = variant, size = .Small).clicked {
				ui.dispatch(d, Set_Filter(filter))
			}
		}
		ui.spacer()
		if ui.button("跳到第 500,000 行", variant = .Ghost, size = .Small).clicked {
			ui.dispatch(d, Jump(500_000))
		}
	}
}

rows_list :: proc(s: ^State, d: ui.Dispatch(Msg)) -> ui.Virtual_List {
	l := ui.virtual_list({
		id = "rows",
		count = len(s.order),
		estimate = 48,
		width = ui.grow(),
		height = ui.grow(),
		key = row_key,
		user = s,
		version = s.version,
	})
	if l.open {
		for i in l.first ..< l.last {
			row_view(s^, d, l, i)
		}
	}
	return l
}

row_view :: proc(s: State, d: ui.Dispatch(Msg), l: ui.Virtual_List, i: int) {
	if ui.virtual_item(l, i, {padding = {12, 10, 12, 10}, gap = 4}) {
		row := s.rows[s.order[i]]
		if ui.row({gap = 8, align_y = .Center}) {
			ui.text(fmt.tprintf("#%d", row.id), .Compact, color = .Faint)
			ui.text(fmt.tprintf("组 %d", row.group), .Compact, color = .Faint)
		}
		ui.text(SENTENCES[row.words], .Body)
		ui.divider()
	}
}

// The height cache's key for a displayed row: its data id, not its position.
@(private)
row_key :: proc(user: rawptr, index: int) -> u64 {
	s := (^State)(user)
	if index < 0 || index >= len(s.order) {
		return u64(index)
	}
	return u64(s.rows[s.order[index]].id)
}

// ---- main ----

main :: proc() {
	window := ui.open_window({title = "一百万行", size = {900, 720}})
	defer ui.close_window(&window)

	store: ui.Store(State, Msg)
	ui.store_init(&store, &window, State{}, update, destroy = state_destroy)
	defer ui.store_destroy(&store)

	for ui.next_frame(&window) {
		view(store.state, ui.dispatcher(&store))
	}
}

state_destroy :: proc(s: ^State) {
	delete(s.rows)
	delete(s.order)
}
